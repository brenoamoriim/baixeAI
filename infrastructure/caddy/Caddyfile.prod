# Production entry point. Caddy obtains and renews the Let's Encrypt certificate automatically
# (HTTP-01 on port 80, which must be open). SITE_DOMAIN e.g. baixeai.duckdns.org, later the own domain.
# Same routing as Caddyfile.dev: /api/* straight to FastAPI (uploads streamed), the rest to Next.js.
# Caddy discards client-supplied X-Forwarded-For (clients are not trusted proxies), so TRUSTED_PROXY_HOPS=1.
# If Cloudflare is put in front later: add `trusted_proxies` with Cloudflare's ranges and use hops=2.
{
	email {$ACME_EMAIL}
	admin off
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
		-Via
	}

	@upload path /api/v1/uploads
	@other not path /api/v1/uploads
	request_body @upload {
		max_size 96MB
	}
	request_body @other {
		max_size 1MB
	}

	# public liveness probe for the external uptime monitor (no internal details)
	handle /healthz {
		reverse_proxy api:8000
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy frontend:3000
	}

	# Privacy policy: no raw client IPs in logs (masked to /16 and /32). Cookies/Authorization are
	# already redacted by Caddy's default.
	log {
		output stdout
		format filter {
			wrap json
			request>remote_ip ip_mask 16 32
			request>client_ip ip_mask 16 32
		}
	}
}
