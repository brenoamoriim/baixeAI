# BaixeAI — environment variables template.
# Copy to `.env` (never commit `.env`) and fill in real values locally.
# No real secret must ever be written in this file.

# --- General ---
APP_ENV=development            # development | test | production
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
TZ_REFERENCE=America/Sao_Paulo

# --- Security ---
SECRET_KEY=                    # long random string (e.g. `python -c "import secrets;print(secrets.token_urlsafe(64))"`)
SIGNED_URL_SECRET=             # separate random string for temporary download links
GUEST_ID_HMAC_SECRET=          # separate random string for hashing anonymous ids / IPs

# --- PostgreSQL ---
POSTGRES_DB=baixeai
POSTGRES_USER=baixeai
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://baixeai:CHANGE_ME@db:5432/baixeai
TEST_DATABASE_URL=postgresql+psycopg://baixeai:CHANGE_ME@db:5432/baixeai_test

# --- Redis ---
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# --- Storage ---
STORAGE_BACKEND=local          # local | s3
STORAGE_LOCAL_ROOT=/data/storage
FILE_RETENTION_HOURS=2

# --- Cookies / proxy ---
COOKIE_SECURE=false            # true in production (HTTPS)
TRUSTED_PROXY_HOPS=1           # proxies in front of the API that set X-Forwarded-For

# --- E-mail (transactional) ---
EMAIL_PROVIDER=console         # console (dev only); a real provider is added before deploy
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Mercado Pago (use TEST credentials outside production) ---
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=             # "assinatura secreta" from the Webhooks panel
MP_WEBHOOK_TOLERANCE_SECONDS=300
API_PUBLIC_URL=                 # public HTTPS URL Mercado Pago can reach (dev: a tunnel), e.g. https://xxxx.trycloudflare.com

# --- Backups (optional, S3-compatible e.g. Cloudflare R2) ---
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_PASSPHRASE=

# --- Monitoring (optional) ---
SENTRY_DSN=
