# BaixeAI — PRODUCTION environment template. On the VM: cp .env.production.example .env && chmod 600 .env
# Fill every value. Never commit .env, never paste these values in chats/tickets. Rotation: docs/OPERACAO.md.
# Generate random secrets with:  openssl rand -base64 48

APP_ENV=production
SITE_DOMAIN=                      # e.g. baixeai.duckdns.org (later the own domain)
ACME_EMAIL=                       # Let's Encrypt expiry notices
APP_BASE_URL=https://${SITE_DOMAIN}
API_PUBLIC_URL=https://${SITE_DOMAIN}
COOKIE_SECURE=true
TRUSTED_PROXY_HOPS=1              # Caddy only. With Cloudflare proxy in front: 2 (and Caddy trusted_proxies)

SECRET_KEY=
SIGNED_URL_SECRET=
GUEST_ID_HMAC_SECRET=

POSTGRES_DB=baixeai
POSTGRES_USER=baixeai
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Transactional e-mail (any SMTP with TLS). Free tier limits of the chosen provider: check before launch.
EMAIL_PROVIDER=smtp
EMAIL_FROM=                       # e.g. nao-responda@seudominio.com.br (provider must authorize this sender)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls            # starttls (587) | ssl (465)
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=                      # where operational alerts go (disk, queues, errors)

# Mercado Pago — PRODUCTION credentials only after the sandbox validation (docs/VALIDACOES-DOS-SOCIOS.md)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Backups: age PUBLIC key (age-keygen; the private key stays OFF the VM with the partners)
BACKUP_AGE_RECIPIENT=
BACKUP_KEEP_DAYS=14
# Optional off-site copy (Cloudflare R2 or another S3-compatible bucket), e.g. r2:baixeai-backups
BACKUP_RCLONE_REMOTE=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
